# ── Database ──
POSTGRES_DB=smartfactory
POSTGRES_USER=sfadmin
POSTGRES_PASSWORD=sfadmin123
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sfadmin:sfadmin123@postgres:5432/smartfactory

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── MinIO (S3-compatible) ──
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=smartfactory-images
MINIO_USE_SSL=false

# ── Backend ──
BACKEND_PORT=8000
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── VLM ──
VLM_PROVIDER=local
# VLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# ── AD Engine ──
AD_MODEL=patchcore
AD_DEVICE=cpu
# AD_DEVICE=cuda
AD_CHECKPOINT_PATH=
# AD_CHECKPOINT_PATH=ml/checkpoints/patchcore/bottle/best.ckpt

# ── Alert ──
ALERT_WEBHOOK_URL=
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_FROM=
